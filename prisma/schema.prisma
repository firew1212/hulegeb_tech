generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RoleCode {
  BUYER
  SELLER
  ADMIN
  DELIVERY_STAFF
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

enum SellerStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  UNAVAILABLE
  REMOVED
}

enum AuthChallengeType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  ADMIN_LOGIN_MFA
}

// ---------- USERS AND ACCESS ----------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String
  firstName       String
  lastName        String
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  userRoles       UserRole[]
  sellerProfile   SellerProfile?
  authChallenges  AuthChallenge[]
  authSessions    AuthSession[]
  authAuditEvents AuthAuditEvent[]

  @@index([status])
  @@index([createdAt])
}

model AuthChallenge {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  type       AuthChallengeType
  tokenHash  String            @unique
  attempts   Int               @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  eventType String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      RoleCode @unique
  createdAt DateTime @default(now())

  userRoles UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ---------- SELLERS ----------

model SellerProfile {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @unique @db.Uuid
  sellerType  SellerType
  displayName String
  legalName   String?
  status      SellerStatus @default(PENDING_APPROVAL)
  approvedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  products Product[]

  @@index([status])
  @@index([sellerType, status])
}

// ---------- CATEGORIES ----------

model Category {
  id            String   @id @default(uuid()) @db.Uuid
  parentId      String?  @db.Uuid
  slug          String   @unique
  nameEn        String
  nameAm        String
  descriptionEn String?
  descriptionAm String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
}

// ---------- PRODUCTS ----------

model Product {
  id            String           @id @default(uuid()) @db.Uuid
  sellerId      String           @db.Uuid
  categoryId    String           @db.Uuid
  slug          String           @unique
  titleEn       String
  titleAm       String
  descriptionEn String?
  descriptionAm String?
  condition     ProductCondition @default(NEW)
  status        ProductStatus    @default(DRAFT)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  seller   SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status, createdAt])
}

// Each size, color, or other sellable variation has its own stock and price.
model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  sku           String   @unique
  name          String
  attributes    Json?
  price         Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isActive])
}

// Store image URLs and metadata, not image files in PostgreSQL.
model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  imageUrl  String
  altTextEn String?
  altTextAm String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model SearchTermAnalytics {
  term             String   @id @db.VarChar(100)
  searchCount      Int      @default(0)
  totalResultCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([searchCount])
}
