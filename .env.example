# Generate independent random secrets of at least 32 characters for each key.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_CHALLENGE_SECRET=replace-with-another-random-secret-at-least-32-characters
AUTH_OTP_MAX_ATTEMPTS=5

# Account-level login protection (rolling window)
# AUTH_LOGIN_MAX_FAILURES (aliases: AUTH_LOGIN_MAX_ATTEMPTS, AUTH_ACCOUNT_LOCKOUT_MAX_FAILURES)
# Maximum qualifying login failures before HTTP 429. Default 5 (range 1-20).
AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_FAILURE_WINDOW_MINUTES (aliases: AUTH_LOGIN_LOCKOUT_MINUTES, AUTH_ACCOUNT_LOCKOUT_MINUTES)
# Rolling failure window in minutes. Default 15 (range 1-1440).
AUTH_LOGIN_FAILURE_WINDOW_MINUTES=15

# Console delivery is allowed only when NODE_ENV is explicitly development/test.
# It prints verification tokens locally; do not enable it in a deployed environment.
NODE_ENV=development
AUTH_EMAIL_MODE=console
AUTH_SMS_MODE=console
FRONTEND_URL=http://localhost:3001

# Explicit browser origins allowed to call the API (comma-separated). Defaults to FRONTEND_URL when unset.
CORS_ALLOWED_ORIGINS=http://localhost:3001


# Production email delivery
# AUTH_EMAIL_MODE=brevo
# BREVO_API_KEY=
# AUTH_EMAIL_FROM=Hulegeb <no-reply@example.com>

# Production SMS delivery webhook
# AUTH_SMS_MODE=webhook
AUTH_SMS_WEBHOOK_URL=
AUTH_DELIVERY_WEBHOOK_TOKEN=

# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings



POSTGRES_USER=hulegeb_user
POSTGRES_PASSWORD=PASTE_YOUR_GENERATED_PASSWORD
POSTGRES_DB=hulegeb_dev

DATABASE_URL="postgresql://hulegeb_user:PASTE_YOUR_GENERATED_PASSWORD@127.0.0.1:5433/hulegeb_dev?schema=public"

# Replace these placeholders with Hulegeb's official buyer support contacts.
# Phone number must use E.164 format; Telegram may be an @username or t.me URL.
HULEGEB_OFFICIAL_PHONE=REPLACE_WITH_E164_PHONE_NUMBER
HULEGEB_OFFICIAL_TELEGRAM=REPLACE_WITH_TELEGRAM_USERNAME_OR_URL

# Optional NestJS Observe integration. Leave all three unset to disable it.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=back-end
